# Copiá este archivo a .env (o corré `pnpm env:local`, que además completa las claves
# de Supabase local). Nunca commitees .env.
#
# Convención:
#   NEXT_PUBLIC_*  → públicas: terminan en el bundle del navegador. Nunca secretos.
#   resto          → privadas: solo servidor Next.js y/o worker (ver packages/config/src/env).

# --- Públicas (web) ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# `supabase status` → ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# --- Privadas del servidor (web) y del worker --------------------------------------
# `supabase status` → SERVICE_ROLE_KEY. Salta RLS: jamás exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Privadas del servidor (web) ----------------------------------------------------
# Opcionales mientras se usa MockPaymentProvider.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Privadas del worker -------------------------------------------------------------
WORKER_CONCURRENCY=2
# IA: mock (sin red ni costo) | openrouter (IA real, cuesta dinero).
AI_PROVIDER=mock
# https://openrouter.ai/keys — configurá un límite de gasto en la clave.
OPENROUTER_API_KEY=
# Shopping: live (tiendas reales, default) | mock (catálogo ficticio, solo tests/E2E; prohibido en producción).
SHOPPING_PROVIDER=live
# Contacto que se agrega al user agent del bot de shopping (URL o email).
SHOPPING_BOT_CONTACT=
# Opcionales: modelos de OpenRouter (defaults en packages/config/src/env/schemas.ts).
OPENROUTER_TEXT_MODEL=
OPENROUTER_IMAGE_MODEL=
# low | medium | high
AI_IMAGE_QUALITY=medium

# --- Comunes -------------------------------------------------------------------------
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
