{
  "name": "@asesor/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@asesor/ai": "workspace:*",
    "@asesor/analytics": "workspace:*",
    "@asesor/config": "workspace:*",
    "@asesor/db": "workspace:*",
    "@asesor/shared": "workspace:*",
    "@asesor/shopping": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
